datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN") // SUPER_ADMIN, ADMIN, EDITOR, STAFF
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id           String   @id @default(cuid())
  trackingCode String?  @unique // e.g. NC-849201
  service      String
  carBrand     String
  carModel     String
  modelYear    String
  date         String
  time         String
  fullName     String
  phone        String
  email        String?
  notes        String?
  status       String   @default("PENDING") // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt    DateTime @default(now())
}

model QuoteRequest {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  carBrand  String
  carModel  String
  modelYear String?
  services  String
  photoUrl  String?
  notes     String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  phone     String    @unique
  email     String?
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
}

model Vehicle {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand       String
  model       String
  year        String
  vin         String?
  ppfStatus   String?   @default("ACTIVE")
  ceramicStat String?   @default("ACTIVE")
  lastService DateTime?
  createdAt   DateTime  @default(now())
}

model GalleryImage {
  id          String   @id @default(cuid())
  url         String
  title       String?
  category    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model CustomerReview {
  id         String   @id @default(cuid())
  author     String
  carModel   String
  content    String
  rating     Int      @default(5)
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("GENEL")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  summary   String
  content   String
  category  String
  image     String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContentVersion {
  id        String   @id @default(cuid())
  section   String   @unique
  content   String
  updatedBy String
  updatedAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  vehicle   String?
  message   String
  status    String   @default("NEW")
  ipAddress String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id                 String   @id @default("default")
  address            String   @default("Mersin, Türkiye")
  fullAddress        String   @default("Yenişehir Mahallesi, 1. Cadde No:33, Mersin, Türkiye")
  phone              String   @default("+90 552 090 06 98")
  email              String   @default("info@ncmastergarage.com")
  workingHours       String   @default("Pzt – Cmt: 09:00 – 19:00 | Pazar: Randevu ile")
  googleMapsEmbedUrl String   @default("https://maps.google.com/maps?q=Mersin,Turkey&t=&z=13&ie=UTF8&iwloc=&output=embed")
  googleMapsLink     String   @default("https://maps.google.com/?q=Mersin")
  updatedAt          DateTime @updatedAt
}

model SocialMediaLink {
  id        String   @id @default(cuid())
  platform  String   // Instagram, WhatsApp, Facebook, YouTube, TikTok, X, LinkedIn, Phone, Email
  title     String
  url       String
  iconName  String   // instagram, phone, mail, facebook, youtube, video, share2, globe
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
